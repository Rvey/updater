# External PostgreSQL URL for deployment. SQLite is used when omitted for local preview.
DATABASE_URL=postgresql://user:password@host:5432/updater?sslmode=require
UPDATER_TOKEN=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
# Set these for a deployed API or a reverse proxy. Include the public hostname (and port if nonstandard).
UPDATER_API_URL=http://127.0.0.1:8000
MCP_ALLOWED_HOSTS=updaterapi.blitzgo.io
# Optional: enables conversational explanations beyond saved context
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.5-flash-lite
